# Bản mẫu cấu hình môi trường — KHÔNG chứa secret.
# Copy sang `.env` và điền giá trị thật trên máy local (không commit `.env`).

# (Tùy chọn) Đường dẫn file .env NẰM NGOÀI repository — tránh hardcode đường dẫn local.
# Local: QA_COPILOT_ENV_FILE=G:\qa-copilot-config\.env
# Server: bỏ trống, dùng Environment Variables / Secret Manager (code chỉ đọc process.env).
QA_COPILOT_ENV_FILE=

# AI
AI_PROVIDER=gemini
ENABLE_AI=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# App đích cho automation
BASE_URL=

# Credential login (chỉ dùng qua process.env, không hardcode)
LOGIN_USERNAME=
LOGIN_PASSWORD=

# Browser cho Playwright Runner:
#   chrome  -> dùng Chrome hệ thống (không cần bundled Chromium)
#   msedge  -> dùng Microsoft Edge hệ thống
#   (bỏ trống -> dùng bundled Chromium, cần `npx playwright install chromium`)
PLAYWRIGHT_BROWSER_CHANNEL=chrome

# Quan sát quá trình automation (không bắt buộc):
#   true  -> chạy headless (mặc định)
#   false -> mở browser hệ thống để tester quan sát
PLAYWRIGHT_HEADLESS=true
# Số ms chờ giữa mỗi hành động (0 = tắt). Vd 500 để chạy chậm khi quan sát.
PLAYWRIGHT_SLOW_MO=0
